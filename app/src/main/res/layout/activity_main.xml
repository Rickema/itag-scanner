<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <!-- Top App Bar in stile moderno Indigo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/primary_indigo"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <!-- Icona Bluetooth in riquadro stondato -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#303F9F">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="ᛒ"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BT Scan and Track"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beacon BLE &amp; Classic Monitor"
                android:textColor="#C5CAE9"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Indicatore stato Target -->
        <TextView
            android:id="@+id/appBarTargetBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LONTANO"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#312E81"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <!-- Indicatore stato o icona rapida -->
        <TextView
            android:id="@+id/appBarBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRO"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#283593"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <include layout="@layout/active_target_banner" />

    <!-- ListView che contiene tutte le card di controllo come HeaderView, garantendo uno scroll uniforme e naturale -->
    <ListView
        android:id="@+id/deviceListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay" />

</LinearLayout>
