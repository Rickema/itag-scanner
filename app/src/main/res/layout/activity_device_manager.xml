<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestione Dispositivi &amp; Tracking"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary_indigo"
            android:layout_marginBottom="14dp" />

        <!-- Tab Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:background="#E0E7FF"
            android:layout_marginBottom="16dp"
            android:padding="2dp">
            <TextView
                android:id="@+id/tabDevice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Dispositivo"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#3F51B5"
                android:background="@drawable/bg_chip_selected" />
            <TextView
                android:id="@+id/tabTracking"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Tracking"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tabMacrodroid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="MacroDroid"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Container Dispositivo -->
        <LinearLayout
            android:id="@+id/tabDeviceContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

        <!-- Card 1: Target Attivo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dispositivo Target Attivo"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/targetNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nessun target selezionato"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_indigo"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/targetMacText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAC: N/D"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/targetTechText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tecnologia: BLE"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/unpairButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Dissocia Dispositivo"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#EF4444"
                    app:cornerRadius="8dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        
        </LinearLayout> <!-- End tabDeviceContent -->

        <!-- Container Tracking -->
        <LinearLayout
            android:id="@+id/tabTrackingContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- Card 2: Configurazione Cicli di Scansione e Pausa -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frequenza &amp; Durata Scansioni"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/durationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Durata scansione attiva: 5 secondi"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="10dp" />

                <SeekBar
                    android:id="@+id/durationSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="30"
                    android:progress="5"
                    android:thumbTint="@color/primary_indigo"
                    android:progressTint="@color/primary_indigo"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/intervalLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intervallo di pausa: 20 secondi"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="10dp" />

                <SeekBar
                    android:id="@+id/intervalSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="120"
                    android:progress="20"
                    android:thumbTint="@color/primary_indigo"
                    android:progressTint="@color/primary_indigo"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/restartServiceButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Applica e Riavvia Servizio"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="@color/primary_indigo"
                    app:cornerRadius="10dp"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout> <!-- End tabTrackingContent -->

        <!-- Container MacroDroid -->
        <LinearLayout
            android:id="@+id/tabMacrodroidContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- Card 3: Test Intent MacroDroid -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test Integrazione MacroDroid"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invia broadcast fittizi per verificare che le tue macro e notifiche rispondano correttamente agli eventi di vicinanza e allontanamento."
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testNearButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Test ACTION_NEAR"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#10B981"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testFarButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Test ACTION_FAR"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#F59E0B"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout> <!-- End tabMacrodroidContent -->

        <!-- Card 4: Archivio Target Memorizzati -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Archivio Target Memorizzati"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:drawableStart="@android:drawable/ic_menu_recent_history"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/primary_indigo"
                        android:textColor="@color/text_primary" />
                    
                    <TextView
                        android:id="@+id/archiveCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 salvati"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_indigo"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Storico di tutti i dispositivi già utilizzati come target. Puoi attivarne uno al volo oppure rimuoverlo dall'archivio."
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/archiveContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                    
                <TextView
                    android:id="@+id/emptyArchiveText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nessun target salvato nell'archivio. Seleziona un dispositivo dalla scansione per aggiungerlo automaticamente."
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:background="#F9FAFB"
                    android:padding="12dp"
                    android:gravity="center"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
